#!/usr/bin/env python3


import os

index_dir = '.mygit/index'
commits_dir = '.mygit/commits'

def get_latest_commit_file(filename):
    try:
        if not os.path.exists(commits_dir):
            return None
        
        # Get all numbered commit directories and find the highest
        commit_nums = [int(d) for d in os.listdir(commits_dir) if d.isdigit()]
        if not commit_nums:
            return None
        latest_commit = max(commit_nums)
        commit_file_path = f'{commits_dir}/{latest_commit}/{filename}'
        return commit_file_path if os.path.exists(commit_file_path) else None
    except:
        return None

# Attain files from current dirdctory, index and commit to check in status
def get_all_files():
    files = set()
    
    for item in os.listdir('.'):
        if os.path.isfile(item) and not item.startswith('.'):
            files.add(item)
    
    if os.path.exists(index_dir):
        for item in os.listdir(index_dir):
            files.add(item)
    
    if os.path.exists(commits_dir):
        commit_nums = [int(d) for d in os.listdir(commits_dir) if d.isdigit()]
        if commit_nums:
            latest_commit = str(max(commit_nums))
            latest_commit_path = os.path.join(commits_dir, latest_commit)
            for item in os.listdir(latest_commit_path):
                files.add(item)
               
    return sorted(files)

def files_are_same(file1, file2):
    try:
        # Read through each file and see if they share the same content
        with open(file1, 'r') as f1, open(file2, 'r') as f2:
            return f1.read() == f2.read()
    except:
        return False

filenames = get_all_files()

for filename in filenames:
    # Skip commit_message.txt and remove-rf from being tracked
    if filename == 'commit_message.txt' or filename == 'remove-rf':
        continue
        
    # See where file can (possibly) exist
    working_path = filename
    index_path = os.path.join(index_dir, filename)
    commit_path = get_latest_commit_file(filename)
    
    in_working = os.path.exists(working_path)
    in_index = os.path.exists(index_path)
    in_commit = commit_path is not None and os.path.exists(commit_path)

    # Set null condition for status if files do not exist
    if not in_working and not in_index and not in_commit:
        print(f"{filename} - untracked")
    
    # Then check other conditions with variations (most index-focused)
    elif not in_working and not in_index and in_commit:
        print(f"{filename} - file deleted, deleted from index")
    
    elif not in_working and in_index and not in_commit:
        print(f"{filename} - added to index, file deleted")
    
    elif not in_working and in_index and in_commit:
        if files_are_same(index_path, commit_path):
            print(f"{filename} - file deleted")
        else:
            print(f"{filename} - file deleted, deleted from index")
    
    elif in_working and not in_index and not in_commit:
        print(f"{filename} - untracked")
    
    elif in_working and not in_index and in_commit:
        print(f"{filename} - deleted from index")
    
    elif in_working and in_index and not in_commit:
        if files_are_same(working_path, index_path):
            print(f"{filename} - added to index")
        else:
            print(f"{filename} - added to index, file changed")